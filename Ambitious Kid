#include<bits/stdc++.h>
using namespace std;

int main(){
    ios::sync_with_stdio(false);
    cin.tie(0);
    int n;
    cin>>n;
    vector<int> ambitions(n);
    bool has_zero = false;
    int min_dis = INT_MAX;
    for(int i = 0; i < n; i++){
        cin>>ambitions[i];
        if(ambitions[i] == 0){
            has_zero = true;
            break;
        }
        min_dis = min(min_dis, abs(ambitions[i]- 0));

    }
    if(has_zero){
        cout<<0<<endl;
    }else{
        cout<<min_dis<<endl;
    }
}

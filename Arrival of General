#include <bits/stdc++.h>
#define ll long long int
#define nline '\n'
using namespace std;
#define rep(i,n) for(int i = 0; i < n; i++)
 
int main(){
    ios::sync_with_stdio(false);
    cin.tie(0);
 
    int n;
    cin>>n;
    
    vector<int> a(n);
    rep(i,n) cin>>a[i];
 
    
    int max_elem,max_ind;
    int min_elem,min_ind;
 
    max_elem = INT_MIN;
    min_elem = INT_MAX;
    for(int i = 0; i < n; i++){
        
        if(a[i] <= min_elem){
            min_elem = a[i];
            min_ind = i;
        }
        if(a[i] > max_elem){
            max_elem = a[i];
            max_ind = i;
        }
    }
    
 
    if(max_ind > min_ind){
        cout<<(max_ind-1)+(n-min_ind) -1<<endl;
    }else{
        cout<<(max_ind-1)+(n-min_ind) <<endl;
    }
    return 0;
 
}

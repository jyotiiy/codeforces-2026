#include<bits/stdc++.h>
using namespace std;


int main(){
    ios::sync_with_stdio(false);
    cin.tie(0);
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int> goals(n-1);
        for(int i = 0;i< n-1; i++){
            cin>>goals[i];
        }
        long long sum = 0;
        for(int i: goals){
            sum+= i;
        }
        cout<<-(sum)<<endl;
    }
}

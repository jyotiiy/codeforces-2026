#include<bits/stdc++.h>
using namespace std;
using ll = long long;
 
int main(){
    ll t;
    cin>>t;
    while(t--){
        ll x,k;
        cin>>x>>k;
        
        if(x %k != 0){
            cout<<1<<endl;
            cout<<x<<endl;
            continue;
        }
        cout<<2<<endl;
        for(int i = x-1; i >= 0; i++){
            if(i%k != 0 && (x-i)%k !=0){
                cout<<i<<" "<<x-i<<endl;
                break;
            }
 
        }
    }
}

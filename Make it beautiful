#include<bits/stdc++.h>
using namespace std;

using ll = long long;
#define rep(i,n) for(int i = 0; i < n; i++)

void solve(){
    ll n;
    cin>>n;

    vector<int> a(n);
    rep(i,n) {
        cin>>a[i];
    }

    sort( a.begin() , a.end() );
    if(a[0] == a[n-1]){
        cout<<"No"<<endl;
    }else{
        cout<<"Yes"<<endl;
        cout<<a.back()<<" ";
        for(int i = 0; i < n-1; i++){
            cout<<a[i]<<" ";
        }
        
        
    }
    
}

signed main(){
    ios::sync_with_stdio(false);
    cin.tie(0);

    ll t;
    cin>>t;
    while(t--){
        solve();
    }
}

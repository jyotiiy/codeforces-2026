#include<bits/stdc++.h>
using namespace std;

#define rep(i,n) for(int i = 0;i < n; i++)
using ll = long long;

void solve(){
    ll n;
    cin>>n;
    string s;
    cin>>s;

    ll st = 0;
    ll end = n-1;
    
    ll count = 0;

    while(st <= end){
        if((s[st] == '0' && s[end] == '1') || (s[st] == '1' && s[end] == '0')){
            count++; 
            st++;
            end--;
        }else{
            break;
        }
    }
    cout<<n - 2*count<<endl;
}
signed main(){
    ll t;
    cin>>t;
    while(t--){
        solve();
    }
}

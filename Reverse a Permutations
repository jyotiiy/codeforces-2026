#include<bits/stdc++.h>
using namespace std;
 
using ll = long long;
#define rep(i,n) for(int i = 0; i < n; i++)
void solve(){
    ll n;
    cin>>n;
 
    vector<int> a(n);
    rep(i,n) cin>>a[i];
 
    vector<int> copy = a;
 
    sort(copy.begin(), copy.end(), greater<>());
    
    ll l = -1;
    ll r;
 
    bool found = false;
    for(int i = 0; i < n; i++){
        if(a[i] == copy[i]){
            found = true;
            continue;
        }
        l = i;
        break;
    }
 
    
    if(l == -1){
        rep(i,n){
            cout<<a[i]<<" ";
        }
        cout<<endl;
        return;
    }
    int mx = a[l];
    for(int i = l; i <n; i++){
        if(a[i] > mx){
            mx = a[i];
            r = i;
        }
    }
 
    for(int i = 0; i < l; i++){
        cout<< a[i] <<" ";
    }
    
    for(int i = r ; i >= l; i--){
        cout<<a[i] <<" ";
    }
    
    if( r == n-1){
        cout<<endl;
        return;
    }
    for(int i = r+1 ; i <n; i++){
        cout<< a[i] <<" ";
    }
 
    cout<<endl;
}
 
signed main(){
    ll t;
    cin>>t;
 
    while(t--){
        solve();
    }
}

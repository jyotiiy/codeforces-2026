#include <bits/stdc++.h>
using namespace std;
#define rep(i,n) for(int i = 0; i < n; i++)
 
int main(){
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
 
        vector<int> a(n);
        rep(i,n) cin >> a[i];
        int len = 1;
        int mx = 1;
        sort(a.begin(),a.end());
        for(int i = 1; i < n; i++){
            if(a[i] == a[i-1]) {
                continue;             
            }
            else if(a[i] == a[i-1] + 1){
                len++;
            }
            else{
                len = 1;
            }
            mx = max(mx, len);
        }
        cout<<mx<<endl;
    }
}

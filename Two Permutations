#include<bits/stdc++.h>
using namespace std;

using ll = long long;
#define rep(i,n) for(int i = 0; i < n; i++)
#define yes cout<<"Yes"<<endl
#define no cout<<"No"<<endl
void solve(){
    ll n,a,b;
    cin>>n>>a>>b;
    
    (a + b <= (n-2) || (a == b && b == n)) ?  yes: no;

}
signed main(){
    ios::sync_with_stdio(false);
    cin.tie(0);
    
    ll t; 
    cin>>t;
    while(t--){
        solve();
    }

}

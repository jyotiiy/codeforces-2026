#include<bits/stdc++.h>
using namespace std;
#define rep(i,n) for(int i = 0; i < n; i++)
void solve(){
    int n;
    cin>>n;
 
    vector<int> a(n);
    int neg = 0;
    rep(i,n){
        cin>>a[i];
        if(a[i] == -1) neg++;
    }
 
    int pos = n-neg;
 
    if( (pos>=neg) && (neg%2 == 0) ){
        cout<<0<<endl;
    }else if((pos>=neg) && (neg%2)){
        cout<<1<<endl;
    }else{
        int diff = neg-pos;
        int change = (diff%2)+diff/2;
        neg-=change;
        if(neg%2 == 1){
            cout<<change+1<<endl;
        }else{
            cout<<change<<endl;
        }
    }
}
int main(){
    int t;
    cin>>t;
    clock_t z = clock();
    while(t--){
        solve();
    }
}

//Divided we shine ;)
#include<bits/stdc++.h>
using namespace std;

#define rep(i,n) for(int i= 0; i < n; i++)
int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int> a(n);
        rep(i,n){
            cin>>a[i];
        }
        vector<int> b;
        vector<int> c;
        int mx = *max_element(a.begin(),a.end());
        rep(i,n){
            if(a[i] != mx){
                b.push_back(a[i]);
            }else{
                c.push_back(a[i]);
            }
        }
        if(b.size() == 0){
            cout<<-1<<endl;
            continue;
        }else{
            cout<<b.size()<<" "<<c.size()<<endl;
            for(auto i: b){
                cout<<i<<" ";
            }
            cout<<endl;
            for(auto i: c){
                cout<<i<<" ";
            }
            cout<<endl;
        }
    }
}
